<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background_gradient">

    <!-- Ana kart -->

    <!-- Büyük logo -->

    <!-- Deneme süresi doldu banner'ı -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loginArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/login_area_background"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="700dp">

        <LinearLayout
            android:id="@+id/topRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Email alanı -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_background_turuncu_focus"
                    android:hint="E-posta"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8F9BB3"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Şifre alanı -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etSifre"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_background_turuncu_focus"
                    android:hint="Şifre"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8F9BB3"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Butonlar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGirisYap"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_panel_rengi"
                    android:focusable="true"
                    android:stateListAnimator="@null"
                    android:text="Giriş Yap"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnKayitOl"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_panel_rengi"
                    android:focusable="true"
                    android:stateListAnimator="@null"
                    android:text="Kayıt Ol"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Google butonu -->

        <!-- Hata mesajı -->

        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="209dp"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_panel_rengi"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="8dp"
            android:stateListAnimator="@null"
            android:text="Google ile Giriş"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topRow" />

        <TextView
            android:id="@+id/tvHata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#20FF3B30"
            android:gravity="center"
            android:padding="10dp"
            android:text=""
            android:textColor="#FFAFA5"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnGoogle" />

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:indeterminateTint="#FF6B2C"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHata" />

        <!-- Trial bilgisi -->
        <TextView
            android:id="@+id/tvTrialBilgisi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="✓ 1 gün ücretsiz deneme"
            android:textColor="#B0D4FF"
            android:textSize="16sp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBar" />

        <!-- Premium bilgi kutusu -->
        <TextView
            android:id="@+id/tvPremiumBilgisi"
            android:layout_width="625dp"
            android:layout_height="77dp"
            android:layout_marginTop="12dp"
            android:background="#33FF6B2C"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:text="🔥 Premium üyelik sadece ₺100 · 2 cihaza kadar kullanım\n📧 Satın almak, sorun bildirmek, öneri ve görüşleriniz için:\n azsh181818@gmail.com"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTrialBilgisi"
            app:layout_constraintVertical_bias="1.0" />

        <!-- ══════════════════════════════════════════════════════════════════
             Doğrulama paneli — başta gizli, kayıt/doğrulanmamış girişte gösterilir
             ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutDogrulama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉"
                android:textSize="36sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDogrulamaEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />
            <EditText
                android:id="@+id/etDogrulamaKodu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/input_background_turuncu_focus"
                android:hint="6 haneli kod"
                android:inputType="number"
                android:maxLength="6"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F9BB3"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnKoduOnayla"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/button_panel_rengi"
                android:stateListAnimator="@null"
                android:text="✔  KODU ONAYLA"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTekrarGonder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/button_panel_rengi"
                android:stateListAnimator="@null"
                android:text="📨  DOĞRULAMA MAİLİNİ TEKRAR GÖNDER"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGirisEkraninaGeri"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/login_area_background"
                android:stateListAnimator="@null"
                android:text="← GİRİŞ EKRANINA DÖN"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvAppAdi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:letterSpacing="0.08"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="AZSH M3U PLAYER"
        android:textColor="#FF6B2C"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTrialDolduBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠ Deneme süreniz doldu. Lütfen iletişime geçin."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="12dp"
        android:background="#CCEF5350"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>