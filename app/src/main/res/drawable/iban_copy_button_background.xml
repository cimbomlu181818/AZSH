<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Basılı durum -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF6B2C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Focus durumu (TV kumandası) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2C4A6A" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#FF6B2C" />
        </shape>
    </item>
    <!-- Normal durum -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2532" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#FF6B2C" />
        </shape>
    </item>
</selector>